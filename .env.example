# Kampung.ai Environment Variables
# Copy this file to .env and fill in your API keys.
#
# Note for Expo: Environment variables must be prefixed with EXPO_PUBLIC_
# to be accessible at runtime. The code reads EXPO_PUBLIC_URA_ACCESS_KEY.

# URA Data Service API (https://www.ura.gov.sg/maps/api/)
# Register at the URA Data Service Portal to get your access key.
# Used for real private property transaction data.
URA_ACCESS_KEY=01d0e87a-5e10-460f-9349-94cd8824c29f
EXPO_PUBLIC_URA_ACCESS_KEY=01d0e87a-5e10-460f-9349-94cd8824c29f

# data.gov.sg API Key (https://data.gov.sg/developer)
DATA_GOV_SG_KEY=

# OneMap API Credentials (https://www.onemap.gov.sg/docs/)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
